# waf-edge — copy to .env for local dev.

LISTEN_ADDR=0.0.0.0:8080

# --- config source (written by control-plane; the ONLY thing this process reads config from) ---
REDIS_URL=redis://localhost:6379
# This value is the config-propagation SLA from the architecture doc (10-30s), in code.
REFRESH_INTERVAL_SECONDS=10

# --- telemetry (up through control-plane, never straight to data-plane) ---
INGEST_URL=http://localhost:4100/ingest/events
# Must match control-plane's INGEST_TOKEN when that is set.
# INGEST_TOKEN=
TELEMETRY_BUFFER=10000
TELEMETRY_MAX_BATCH=100
TELEMETRY_FLUSH_MS=2000

# --- client identification ---
# UNSET BY DEFAULT ON PURPOSE. Setting this makes the edge trust a request header for the client's
# IP, which lets anyone spoof their source address past every IP rule and every rate limit. Only
# set it when something in front of this node is guaranteed to overwrite the header.
# CLIENT_IP_HEADER=X-Forwarded-For
# There is no GeoIP database in this build; country rules never match unless something upstream
# resolves the country and puts it in this header.
# GEO_COUNTRY_HEADER=CF-IPCountry

# --- challenge clearance ---
CLEARANCE_COOKIE=waf_clearance
CLEARANCE_TTL_SECONDS=1800
# Leave unset for a per-node random secret (a restart re-challenges visitors). Set it to a shared
# value so a fleet honours each other's clearances.
# CLEARANCE_SECRET=
