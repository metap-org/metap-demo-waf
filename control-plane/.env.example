# waf-config-distributor — copy to .env for local dev.

# --- data-plane (read config from, write telemetry to) ---
ZONES_URL=http://localhost:3000
ALERTING_URL=http://localhost:3020
CONTROL_LOGIN_URL=http://localhost:3000/auth/login
# A real user in the tenant this worker distributes config for. Create it with
# `cargo run --manifest-path ../../metap/crates/metap-dev-tools/Cargo.toml -- create-user <tenantId> ...`
# and give it read access to waf.zones / waf.ddos_policies / waf.firewall_rules plus create on
# waf.security_events. Not a hand-minted JWT: this logs in and refreshes in the background.
CONTROL_SERVICE_EMAIL=control-plane@example.com
CONTROL_SERVICE_PASSWORD=change-me

# --- distribution target (edge-plane reads these keys) ---
REDIS_URL=redis://localhost:6379

# --- change feed ---
AMQP_URL=amqp://guest:guest@localhost:5672/%2f
# Fixed name so replicas share one queue and compete for messages instead of each recompiling the
# same change.
CONFIG_DISTRIBUTOR_QUEUE=waf.config-distributor

# --- convergence ---
# The full sweep is what guarantees the edge is correct; the event feed is only the fast path.
RESYNC_INTERVAL_SECONDS=60

# --- telemetry ingest (edge-plane posts here) ---
HOST=0.0.0.0
PORT=4100
INGEST_MAX_BATCH=200
INGEST_MAX_REQUEST_EVENTS=1000
# Shared secret the edge must present as `X-WAF-Ingest-Token`. Leave unset in dev to disable the
# check; set it anywhere the ingest port is reachable by anything but your own edge nodes.
# INGEST_TOKEN=
