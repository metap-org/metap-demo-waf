NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# This gateway must decode-verify against the SAME trust root the 3 WAF services mint with —
# found live once already (a gateway with its own separate keypair failed to decode a real login
# token, "invalid or expired token"): any token valid for REST must also be valid for /graphql,
# no separate gateway-specific token. `JWKS_URL`/`AUTH_JWT_PUBLIC_KEY_PATH` are mutually
# exclusive (`GatewayConfig::from_env`'s doc comment) — set exactly one.
#
# Default now: JWKS (metap-jwks, EdDSA) — the 3 services' shared trust root, published by
# zones-service. No private key file needed here at all (verify-only).
JWKS_URL=http://localhost:3000/.well-known/jwks.json
# Opt-in: accept the session cookie directly (same double-submit CSRF as REST) instead of
# requiring a fresh Bearer token per call (`GET /auth/token`) — safe only when this gateway is
# reached through the same origin as the services issuing the cookie (true here: Vite proxy /
# nginx both route /graphql and /auth/* to the same origin). See server.rs's module doc comment.
COOKIE_AUTH_ENABLED=true
# RSA fallback (unused while JWKS_URL above is set) — kept for a deployment that hasn't
# generated a JWKS key yet (`dev-tools gen-jwks-key`). Same key the 3 services' RSA fallback
# uses (../keys/dev-jwt-public.pem), not a separate dedicated one, for the same reason as above.
# AUTH_JWT_PUBLIC_KEY_PATH=../keys/dev-jwt-public.pem

# 3 upstreams — the WAF Customer Portal backend's own pillar services (see ../README.md's
# service/port table). UPSTREAM_<N>_LOGIN_URL/SERVICE_EMAIL/SERVICE_PASSWORD are a real user
# (`dev-tools create-user`/`dev-tools seed-admin`) the gateway logs into via that upstream's own
# POST /auth/login at boot, and re-logs-into automatically in the background before the token
# expires (`metap_grpc::ServiceTokenSource`) — no hand-minted JWT to paste in or refresh by hand.
# All 3 WAF services share one DB, so one email/password works for all 3 login calls.
UPSTREAM_1_NAME=zones
UPSTREAM_1_GRPC_ADDR=http://localhost:3001
UPSTREAM_1_METADATA_URL=http://localhost:3000/metadata/entities
UPSTREAM_1_LOGIN_URL=http://localhost:3000/auth/login
UPSTREAM_1_SERVICE_EMAIL=
UPSTREAM_1_SERVICE_PASSWORD=

UPSTREAM_2_NAME=scanning
UPSTREAM_2_GRPC_ADDR=http://localhost:3011
UPSTREAM_2_METADATA_URL=http://localhost:3010/metadata/entities
UPSTREAM_2_LOGIN_URL=http://localhost:3010/auth/login
UPSTREAM_2_SERVICE_EMAIL=
UPSTREAM_2_SERVICE_PASSWORD=

UPSTREAM_3_NAME=alerting
UPSTREAM_3_GRPC_ADDR=http://localhost:3021
UPSTREAM_3_METADATA_URL=http://localhost:3020/metadata/entities
UPSTREAM_3_LOGIN_URL=http://localhost:3020/auth/login
UPSTREAM_3_SERVICE_EMAIL=
UPSTREAM_3_SERVICE_PASSWORD=
