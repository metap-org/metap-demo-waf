# Used only by `docker-compose.yml` (variable substitution for `graphql-gateway`'s
# UPSTREAM_*_SERVICE_EMAIL/UPSTREAM_*_SERVICE_PASSWORD — see that file's own top comment). This is
# a real user the gateway logs into via each upstream's own `POST /auth/login` at boot and
# re-logs-into automatically before the token expires — not a hand-minted JWT to refresh by hand.
# Copy this file to `.env` next to `docker-compose.yml` and fill in real values — docker compose
# auto-loads a `.env` file from the project directory, no extra flag needed.
#
# Provision one (needs zones-service, or any 1 of the 3, reachable — or DATABASE_URL directly):
#   cargo run --manifest-path ../../metap/crates/metap-dev-tools/Cargo.toml -- create-user <tenantId> <email> <password>
#   cargo run --manifest-path ../../metap/crates/metap-dev-tools/Cargo.toml -- seed-admin <tenantId> <userId>
WAF_SERVICE_EMAIL=
WAF_SERVICE_PASSWORD=
