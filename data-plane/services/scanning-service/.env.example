NODE_ENV=development
HOST=0.0.0.0
PORT=3010
# Same tenant database as zones-service/alerting-service — split by compute/deploy/ownership,
# not by data layer (see main.rs's doc comment for why).
DATABASE_URL=postgres://metap:metap@localhost:5433/metap
RABBITMQ_URL=amqp://metap:metap@localhost:5672
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# RSA fallback — only used when JWKS_PRIVATE_KEY_PATH/JWKS_KID_PATH below are unset.
AUTH_JWT_PUBLIC_KEY_PATH=../../keys/dev-jwt-public.pem
AUTH_JWT_PRIVATE_KEY_PATH=../../keys/dev-jwt-private.pem
# JWKS trust root (metap-jwks, EdDSA) — the default mint/verify path once set (`dev-tools
# gen-jwks-key keys` generates the 2 files below). All 3 services share this key; only
# zones-service publishes it (`/.well-known/jwks.json`) — this service verifies via JWKS_URL,
# pointed at that one.
JWKS_PRIVATE_KEY_PATH=../../keys/dev-jwks-private.der
JWKS_KID_PATH=../../keys/dev-jwks-kid.txt
JWKS_URL=http://localhost:3000/.well-known/jwks.json
# Opt-in gRPC (this service's own AuthConfig, see main.rs) — set true to let a graphql-gateway
# instance aggregate this service. Default port 3011 if unset.
GRPC_ENABLED=false
GRPC_PORT=3011
