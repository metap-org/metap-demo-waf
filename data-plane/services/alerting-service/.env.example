NODE_ENV=development
HOST=0.0.0.0
PORT=3020
# Same tenant database as zones-service/scanning-service — split by compute/deploy/ownership,
# not by data layer (see main.rs's doc comment for why).
DATABASE_URL=postgres://metap:metap@localhost:5433/metap
RABBITMQ_URL=amqp://metap:metap@localhost:5672
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Shared keypair across all 3 services — a token minted by any one of them verifies on all 3.
AUTH_JWT_PUBLIC_KEY_PATH=../../keys/dev-jwt-public.pem
AUTH_JWT_PRIVATE_KEY_PATH=../../keys/dev-jwt-private.pem
# Opt-in gRPC (metap::grpc::optional_serve) — set true to let a graphql-gateway instance
# aggregate this service. Default port 3021 if unset.
GRPC_ENABLED=false
GRPC_PORT=3021
